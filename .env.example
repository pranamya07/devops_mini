APP_NAME=Task Management API
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL credentials used by Docker Compose. Change the password.
POSTGRES_USER=taskapi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskapi

# Grafana admin login (dashboards are viewable without logging in).
GRAFANA_ADMIN_PASSWORD=change-me

# Host ports, if the defaults are already in use on your machine.
# API_PORT=8000
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
